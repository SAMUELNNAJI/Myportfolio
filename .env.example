# Public site URL - used for metadata, canonical links, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Project dashboard
# ---------------------------------------------------------------------------
# Password required to sign in at /dashboard. Without this the dashboard is
# locked and /api/admin/login returns 503 (NOT_CONFIGURED).
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie. Defaults to
# ADMIN_PASSWORD if unset. Set to a long random string in production.
# ADMIN_SESSION_SECRET=

# Optional: change where projects are stored (must be writable).
# PROJECTS_DIR=./data

# ---------------------------------------------------------------------------
# Contact form delivery (optional)
# ---------------------------------------------------------------------------
# Without one of these options the form still validates input but returns a
# clear "not connected" state — it never pretends a message was sent.

# Option A — Resend (https://resend.com). Recommended.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified sender/domain in Resend. Until then, leave empty to use
# Resend's test sender (which can only deliver to your own account email).
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Option B — SMTP (e.g. Gmail, SendGrid, Mailgun). Set these to send via your own mail server.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=your-app-password (generate at https://myaccount.google.com/apppasswords)
# SMTP_FROM="Portfolio <your@gmail.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Option C — any form service that accepts a JSON POST (e.g. Formspree).
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id
